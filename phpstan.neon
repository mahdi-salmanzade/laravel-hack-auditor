includes:
    - ./vendor/larastan/larastan/extension.neon
    # 84 pre-existing level-8 findings, captured so CI blocks new ones while the
    # existing debt stays visible. Shrink it, never regenerate it wholesale.
    - ./phpstan-baseline.neon

parameters:
    paths:
        - src/

    level: 8

    ignoreErrors: []
