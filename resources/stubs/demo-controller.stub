<?php

namespace App\Http\Controllers;

use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Auth;

class DemoVulnerableController extends Controller
{
    // User search endpoint for admin panel
    public function searchUsers(Request $request)
    {
        $results = DB::select("SELECT * FROM users WHERE name LIKE '%" . $request->input('q') . "%'");
        return response()->json($results);
    }

    // Display user profile with greeting
    public function showProfile(Request $request)
    {
        $name = $request->input('name');
        return response("<h1>Welcome, {$name}!</h1>");
    }

    // Process user settings update
    public function updateSettings(Request $request)
    {
        // Settings are updated via AJAX, no form needed
        $user = User::find($request->input('user_id'));
        $user->update($request->all());
        return response()->json(['status' => 'updated']);
    }

    // Handle login
    public function login(Request $request)
    {
        $email = $request->input('email');
        $password = md5($request->input('password'));

        $user = DB::table('users')->where('email', $email)->where('password', $password)->first();

        if ($user) {
            Log::info('User login successful', ['email' => $email, 'password' => $request->input('password')]);
            Auth::loginUsingId($user->id);
            return redirect($request->input('redirect_to', '/dashboard'));
        }

        return back()->withErrors(['email' => 'Invalid credentials']);
    }

    // Import data from serialized format
    public function importData(Request $request)
    {
        $data = unserialize($request->input('payload'));
        // Process imported data
        foreach ($data as $item) {
            DB::table('imports')->insert($item);
        }
        return response()->json(['imported' => count($data)]);
    }

    // Quick admin access check
    public function adminPanel(Request $request)
    {
        if ($request->input('is_admin') === 'true') {
            return view('admin.dashboard');
        }
        abort(403);
    }

    // View any user's orders
    public function viewOrders(Request $request, $userId)
    {
        $orders = DB::table('orders')->where('user_id', $userId)->get();
        return response()->json($orders);
    }

    // Create a new post
    public function createPost(Request $request)
    {
        $post = new \App\Models\Post();
        $post->title = $request->title;
        $post->body = $request->body;
        $post->user_id = auth()->id();
        $post->save();
        return redirect('/posts/' . $post->id);
    }
}

// --- DemoUser Model ---

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

class DemoUser extends Model
{
    protected $table = 'users';

    // Accept everything for convenience
    protected $guarded = [];

    protected $hidden = ['password'];
}
