{
    "name": "mahdisphp/laravel-hack-auditor",
    "description": "AI-powered security auditor & CTF generator for Laravel. Watch AI hack your app in 15 seconds.",
    "keywords": ["laravel", "security", "audit", "ctf", "ai", "vulnerability", "scanner", "hacking", "penetration-testing"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mahdi Abazar Salmanzadeh",
            "email": "mahdi@mindzone.tech"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/ai": "^0.11|^1.0",
        "laravel/mcp": "^0.6|^0.7.1|^0.8|^0.9",
        "illuminate/support": "^12.41.1|^13.0",
        "illuminate/console": "^12.41.1|^13.0",
        "nikic/php-parser": "^5.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30.5",
        "orchestra/testbench": "^10.11|^11.2",
        "pestphp/pest": "^4.7|^5.1"
    },
    "autoload": {
        "psr-4": {
            "Mahdi\\HackAuditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mahdi\\HackAuditor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mahdi\\HackAuditor\\HackAuditorServiceProvider"
            ],
            "aliases": {
                "HackAuditor": "Mahdi\\HackAuditor\\Facades\\HackAuditor"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
